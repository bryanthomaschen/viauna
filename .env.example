# Copy to .env for `npm run dev`. Defaults below point at the dev mail server
# started by `npm run dev:mail` (dev/compose.yml).
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_SECURITY=none
SMTP_HOST=127.0.0.1
SMTP_PORT=1587
SMTP_SECURITY=none
# Filters: the dev server's ManageSieve (the host and encryption follow IMAP's).
MANAGESIEVE_PORT=14190
PUBLIC_URL=http://127.0.0.1:5173
DATA_DIR=./data
LOG_LEVEL=info
