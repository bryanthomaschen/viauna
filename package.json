{
  "name": "viauna",
  "version": "0.2.0",
  "private": true,
  "description": "A fast, Gmail-style webmail client for any IMAP/SMTP server.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node dev/run.mjs",
    "dev:server": "tsx watch --clear-screen=false --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "dev:mail": "docker compose -f dev/compose.yml up -d && node dev/smtp-sink.mjs",
    "dev:databases": "docker compose -f dev/databases.yml up -d",
    "seed": "tsx dev/seed.ts",
    "build": "vite build && node build-server.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "cli": "tsx --env-file-if-exists=.env server/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "VIAUNA_IT=1 vitest run test/integration.test.ts",
    "check:release": "node dev/release.mjs check"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "entities": "^8.1.0",
    "hono": "^4.13.13",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.5.2",
    "kysely": "^0.29.6",
    "linkedom": "^0.18.13",
    "mailparser": "^3.9.40",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.3",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "^3.19.23",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
